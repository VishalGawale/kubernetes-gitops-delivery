{
  "title": "ai-platform",
  "uid": "ai-platform",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate (req/s, excluding probes and scrapes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{environment}}",
        "expr": "sum by (environment) (rate(http_requests_total{path!~\"/healthz|/metrics\"}[5m]))" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{environment}}",
        "expr": "histogram_quantile(0.95, sum by (le, environment) (rate(http_request_duration_seconds_bucket{path!~\"/healthz|/metrics\"}[5m])))" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Error rate (5xx share of requests)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "min": 0, "max": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{environment}}",
        "expr": "(sum by (environment) (rate(http_requests_total{status=~\"5..\",path!~\"/healthz|/metrics\"}[5m])) or sum by (environment) (rate(http_requests_total{path!~\"/healthz|/metrics\"}[5m])) * 0) / sum by (environment) (rate(http_requests_total{path!~\"/healthz|/metrics\"}[5m]))" } ]
    }
  ]
}